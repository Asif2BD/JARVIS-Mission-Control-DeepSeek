# JARVIS Mission Control — Environment Variables
# Copy to .env and fill in values

# ============================================
# BASIC AUTH PROTECTION
# ============================================
# Set MC_AUTH_PASS to enable password protection on the dashboard.
# Leave blank for local development (auth disabled).
MC_AUTH_USER=architect
MC_AUTH_PASS=

# Optional: agent token to allow API access without basic auth
# (used by the dsh plugin: set the same value in its authToken config)
MC_AGENT_TOKEN=

# ============================================
# GITHUB INTEGRATION
# ============================================
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# ============================================
# SERVER
# ============================================
PORT=3000

# ============================================
# AGENT WORKSPACE FILES (optional)
# ============================================
# Directory of per-agent workspace folders (SOUL.md, MEMORY.md, IDENTITY.md)
# for the dashboard's Agent Files editor. Leave unset to disable the feature
# (defaults to ./agents-workspace, shown as empty until it exists).
AGENTS_DIR=
